<Window x:Class="ChartSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChartSample"
        mc:Ignorable="d"
        xmlns:chart="clr-namespace:Syncfusion.UI.Xaml.Charts;assembly=Syncfusion.SfChart.WPF"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.DataContext>
            <local:ViewModel x:Name="viewModel"/>
        </Grid.DataContext>
        <Label Content="Automotive Performance Overview" 
               Padding="4"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontSize="20"
               FontWeight="Bold"
               Grid.Row="0"/>
        
        <chart:SfChart Series="{Binding Series}" 
                       Palette="Custom"
                       Grid.Row="1"
                       Margin="20,0">
            <chart:SfChart.Legend>
                <chart:ChartLegend ToggleSeriesVisibility="True"
                                   IconHeight="10"
                                   IconWidth="10"
                                   FontSize="14"
                                   ItemMargin="6"/>
            </chart:SfChart.Legend>
            
            <chart:SfChart.ColorModel>
                <chart:ChartColorModel>
                    <chart:ChartColorModel.CustomBrushes>
                        <SolidColorBrush Color="Blue"/>
                        <SolidColorBrush Color="Red"/>
                        <SolidColorBrush Color="Green"/>
                        <SolidColorBrush Color="BlueViolet"/>
                    </chart:ChartColorModel.CustomBrushes>
                </chart:ChartColorModel>
            </chart:SfChart.ColorModel>

            <chart:SfChart.PrimaryAxis>
                <chart:CategoryAxis LabelPlacement="BetweenTicks">
                    <chart:CategoryAxis.LabelStyle>
                        <chart:LabelStyle FontSize="18" />
                    </chart:CategoryAxis.LabelStyle>
                </chart:CategoryAxis>
            </chart:SfChart.PrimaryAxis>
            
            <chart:SfChart.SecondaryAxis>
                <chart:NumericalAxis Interval="5" Maximum="45">
                    <chart:NumericalAxis.LabelStyle>
                        <chart:LabelStyle FontSize="18" />
                    </chart:NumericalAxis.LabelStyle>
                </chart:NumericalAxis>
            </chart:SfChart.SecondaryAxis>
        </chart:SfChart>
        
        <Grid Grid.Row="2"
              HorizontalAlignment="Center"
              Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Add Series" 
                    Padding="4"
                    Margin="4"
                    Click="Add_Button_Click" 
                    Height="45"
                    FontWeight="Bold"
                    Width="100"/>
            <Button Grid.Column="1" 
                    Click="Remove_Button_Click" 
                    Height="45"
                    Width="100"
                    Margin="4"
                    Padding="4"
                    FontWeight="Bold"
                    Content="Remove Series"/>
        </Grid>
    </Grid>

</Window>
